#!/bin/bash
#
# spawnpoint installer: wires spawnpoint into every coding agent on this
# machine (Claude Code, Codex (CLI or the ChatGPT app), Cursor, opencode,
# GitHub Copilot CLI, VS Code Copilot, jcode, DeepSeek Harness, Antigravity).
#
#   curl -fsSL https://getspawnpoint.com/install | bash
#
# Safe to re-run. Wires each agent it finds; skips the ones it doesn't.
# Restrict to specific agents with SPAWNPOINT_AGENT (comma-separated):
#
#   curl -fsSL https://getspawnpoint.com/install | SPAWNPOINT_AGENT=codex bash
#
# Points agents at the hosted spawnpoint (https://app.getspawnpoint.com) by
# default; override with SPAWNPOINT_URL for a dev instance:
#
#   curl -fsSL https://getspawnpoint.com/install | SPAWNPOINT_URL=http://localhost:8080 bash
#
# A team's install line, copied from the team page in the console, also
# carries SPAWNPOINT_TEAM: a code that works once, for 15 minutes. The
# script trades it for the team's MCP servers and skills and adds them to
# Claude Code and Codex.
set -euo pipefail

# ---- pretty ----------------------------------------------------------------
if [ -t 1 ] && [ -z "${NO_COLOR:-}" ]; then
  SP_MARK=$'\033[48;2;204;0;51m\033[1;97m'   # white on scarlet, the sp squircle
  RED=$'\033[38;2;204;0;51m'
  GREEN=$'\033[38;2;79;154;95m'
  DIM=$'\033[2m'
  BOLD=$'\033[1m'
  RESET=$'\033[0m'
else
  SP_MARK=""; RED=""; GREEN=""; DIM=""; BOLD=""; RESET=""
fi

step() { printf '%s==>%s %s%s%s\n' "$RED" "$RESET" "$BOLD" "$1" "$RESET"; }
ok()   { printf '  %s✓%s %s\n' "$GREEN" "$RESET" "$1"; }
note() { printf '  %s%s%s\n' "$DIM" "$1" "$RESET"; }
warn() { printf '  %s! %s%s\n' "$RED" "$1" "$RESET"; }
die()  { printf '  %sx %s%s\n' "$RED" "$1" "$RESET" >&2; exit 1; }

printf '\n  %s sp %s %sspawnpoint%s\n' "$SP_MARK" "$RESET" "$BOLD" "$RESET"
printf "       %sthe place where your team's AI lives%s\n\n" "$DIM" "$RESET"

URL="${SPAWNPOINT_URL:-https://app.getspawnpoint.com}"
AGENTS="${SPAWNPOINT_AGENT:-}"
TEAM_CODE="${SPAWNPOINT_TEAM:-}"
TEAM_FILE=""   # the team's servers and skills, fetched once (the code works once)
WIRED=""   # agents successfully wired
STEPS=""   # per-agent next-step lines, printed at the end

wants() {  # is this agent requested (or is everything requested)?
  [ -z "$AGENTS" ] || printf '%s' ",$AGENTS," | grep -q ",$1,"
}

# has PATTERN CMD...: CMD's output holds PATTERN. The output is read in
# full first: piped straight into grep -q, an agent CLI still writing when
# grep stops reading can die of the closed pipe (Codex exits 101), and
# pipefail then reads the match as a miss, which re-pointed a server that
# was already right.
has() {
  local pattern=$1 out
  shift
  out=$("$@" 2>/dev/null) || true
  printf '%s\n' "$out" | grep -q -- "$pattern"
}

# ---- Claude Code: plugin (skills) + MCP ------------------------------------
# The desktop app (Claude.app) bundles its own Claude Code runtime that reads
# the same user-scope config (~/.claude.json, ~/.claude/plugins) as the CLI.
# So a machine with only the desktop app still gets wired: find_claude prefers
# the PATH CLI, then falls back to the newest bundled runtime. Verified on
# macOS (app 1.28929.0 bundling Claude Code 2.1.227): mcp/plugin/marketplace
# subcommands all work headlessly through the bundled binary.
find_claude() {
  if command -v claude >/dev/null 2>&1; then
    printf 'claude'
    return 0
  fi
  local base="$HOME/Library/Application Support/Claude/claude-code"
  if [ -d "$base" ]; then
    local newest
    newest=$(ls "$base" 2>/dev/null | sort -V | tail -1)
    local bin="$base/$newest/claude.app/Contents/MacOS/claude"
    if [ -x "$bin" ]; then
      printf '%s' "$bin"
      return 0
    fi
  fi
  return 1
}

# Claude Code leaves a third-party marketplace on manual updates, so a
# plugin release never reached anyone who had installed it earlier: one
# user was four releases behind, on skills that no longer matched the
# server. `marketplace add` declares the marketplace in the user's
# settings.json, and an autoUpdate there is what Claude Code reads first
# (code.claude.com/docs/en/plugins/loading). The installer sets it on that
# one entry and leaves the rest of the file as it was; a file that isn't
# plain JSON is left alone.
claude_auto_update() {
  if ! command -v python3 >/dev/null 2>&1; then
    note "to get plugin updates by themselves: in Claude Code, /plugin, Marketplaces, spawnpoint, Enable auto-update"
    return 0
  fi
  local rc=0
  python3 - <<'PYEOF' || rc=$?
import json, os, pathlib, sys
home = pathlib.Path(os.environ.get("CLAUDE_CONFIG_DIR") or (pathlib.Path.home() / ".claude"))
p = home / "settings.json"
try:
    cfg = json.loads(p.read_text() or "{}") if p.exists() else {}
except ValueError:
    sys.exit(3)
if not isinstance(cfg, dict):
    sys.exit(3)
markets = cfg.setdefault("extraKnownMarketplaces", {})
if not isinstance(markets, dict):
    sys.exit(3)
entry = markets.setdefault("spawnpoint", {"source": {"source": "github", "repo": "spawnpoint-inc/spawnpoint-plugin"}})
if not isinstance(entry, dict):
    sys.exit(3)
if entry.get("autoUpdate") is True:
    sys.exit(4)
entry["autoUpdate"] = True
home.mkdir(parents=True, exist_ok=True)
tmp = p.with_name(p.name + ".spawnpoint-tmp")
tmp.write_text(json.dumps(cfg, indent=2) + "\n")
if p.exists():
    os.chmod(tmp, p.stat().st_mode & 0o777)
os.replace(tmp, p)
PYEOF
  case $rc in
    0) ok "plugin updates turned on: new versions install by themselves" ;;
    4) ok "plugin updates already on" ;;
    *) note "to get plugin updates by themselves: in Claude Code, /plugin, Marketplaces, spawnpoint, Enable auto-update" ;;
  esac
}

wire_claude() {
  step "Claude Code"
  local CLAUDE
  if ! CLAUDE=$(find_claude); then
    note "not found, skipping"
    return 1
  fi
  case "$CLAUDE" in
    claude) : ;;
    *) note "CLI not on PATH; using the desktop app's bundled runtime" ;;
  esac
  if "$CLAUDE" plugin marketplace add spawnpoint-inc/spawnpoint-plugin >/dev/null 2>&1; then
    ok "marketplace added (spawnpoint-inc/spawnpoint-plugin)"
  elif "$CLAUDE" plugin marketplace update spawnpoint >/dev/null 2>&1; then
    ok "marketplace already present, refreshed"
  else
    warn "could not add the marketplace; try: claude plugin marketplace add spawnpoint-inc/spawnpoint-plugin"
    return 1
  fi
  if has 'spawnpoint@spawnpoint' "$CLAUDE" plugin list; then
    ok "plugin already installed, updating"
    "$CLAUDE" plugin update spawnpoint@spawnpoint >/dev/null 2>&1 || true
  elif "$CLAUDE" plugin install spawnpoint@spawnpoint >/dev/null 2>&1; then
    ok "plugin installed (spawnpoint's skills)"
  else
    warn "plugin install failed; try: claude plugin install spawnpoint@spawnpoint"
    return 1
  fi
  claude_auto_update
  if has "$URL/mcp" "$CLAUDE" mcp get spawnpoint; then
    ok "MCP server already registered"
  else
    if has '^spawnpoint:' "$CLAUDE" mcp list; then
      note "registered at a stale URL, re-pointing"
      "$CLAUDE" mcp remove spawnpoint -s user >/dev/null 2>&1 || true
    fi
    if "$CLAUDE" mcp add --transport http --scope user spawnpoint "$URL/mcp" >/dev/null 2>&1; then
      ok "MCP server registered ($URL/mcp)"
    else
      warn "could not register; try: claude mcp add --transport http --scope user spawnpoint $URL/mcp"
      return 1
    fi
  fi
  case "$CLAUDE" in
    claude) STEPS="$STEPS
  Claude Code:  restart it, run /mcp, pick spawnpoint, choose Authenticate." ;;
    *) STEPS="$STEPS
  Claude app:   restart it, open the Code tab, run /mcp, pick spawnpoint, Authenticate." ;;
  esac
}

# ---- Codex: MCP over streamable HTTP ---------------------------------------
# Codex ships two ways: the standalone CLI, and bundled inside the ChatGPT
# desktop app (no `codex` on PATH). Both read ~/.codex, so wiring through
# either binary configures both. Prefer the PATH CLI; fall back to the app's.
CODEX_APP_BIN="/Applications/ChatGPT.app/Contents/Resources/codex"

find_codex() {
  if command -v codex >/dev/null 2>&1; then
    printf 'codex'
    return 0
  fi
  if [ -x "$CODEX_APP_BIN" ]; then
    printf '%s' "$CODEX_APP_BIN"
    return 0
  fi
  return 1
}

wire_codex() {
  step "Codex"
  local CODEX
  if ! CODEX=$(find_codex); then
    note "not found, skipping"
    return 1
  fi
  case "$CODEX" in
    codex) : ;;
    *) note "CLI not on PATH; using the ChatGPT app's bundled Codex" ;;
  esac
  if has "$URL/mcp" "$CODEX" mcp get spawnpoint; then
    ok "MCP server already registered"
  else
    if "$CODEX" mcp get spawnpoint >/dev/null 2>&1; then
      note "registered at a stale URL, re-pointing"
      "$CODEX" mcp remove spawnpoint >/dev/null 2>&1 || true
    fi
    if "$CODEX" mcp add spawnpoint --url "$URL/mcp" >/dev/null 2>&1; then
      ok "MCP server registered ($URL/mcp)"
    else
      warn "could not register; try: codex mcp add spawnpoint --url $URL/mcp"
      return 1
    fi
  fi
  case "$CODEX" in
    codex) STEPS="$STEPS
  Codex:        run: codex mcp login spawnpoint   (approve in the browser)" ;;
    *) STEPS="$STEPS
  Codex:        in the ChatGPT app, open Codex and approve spawnpoint (sign-in opens in the browser)" ;;
  esac
}

# ---- Cursor (IDE + cursor-agent share ~/.cursor/mcp.json) ------------------
wire_cursor() {
  step "Cursor"
  if ! command -v python3 >/dev/null 2>&1; then
    warn "python3 not found; add spawnpoint to ~/.cursor/mcp.json by hand"
    return 1
  fi
  if ! SPAWNPOINT_MCP_URL="$URL/mcp" python3 - <<'PYEOF'
import json, os, pathlib
p = pathlib.Path.home() / ".cursor" / "mcp.json"
p.parent.mkdir(parents=True, exist_ok=True)
cfg = {}
if p.exists():
    try:
        cfg = json.loads(p.read_text() or "{}")
    except ValueError:
        raise SystemExit("existing mcp.json is not valid JSON; not touching it")
servers = cfg.setdefault("mcpServers", {})
servers["spawnpoint"] = {"url": os.environ["SPAWNPOINT_MCP_URL"]}
p.write_text(json.dumps(cfg, indent=2) + "\n")
PYEOF
  then
    warn "could not update ~/.cursor/mcp.json"
    return 1
  fi
  ok "registered in ~/.cursor/mcp.json ($URL/mcp)"
  if command -v cursor-agent >/dev/null 2>&1; then
    STEPS="$STEPS
  Cursor:       run: cursor-agent mcp login spawnpoint   (or approve in the IDE's MCP settings)"
  else
    STEPS="$STEPS
  Cursor:       open the IDE's MCP settings and approve spawnpoint (sign-in happens in the browser)."
  fi
}

# ---- opencode: remote MCP over streamable HTTP -----------------------------
wire_opencode() {
  step "opencode"
  if has "$URL/mcp" opencode mcp list; then
    ok "MCP server already registered"
  elif opencode mcp add spawnpoint --url "$URL/mcp" >/dev/null 2>&1; then
    ok "MCP server registered ($URL/mcp)"
  else
    warn "could not register; try: opencode mcp add spawnpoint --url $URL/mcp"
    return 1
  fi
  STEPS="$STEPS
  opencode:     run: opencode mcp auth spawnpoint   (approve in the browser)"
}

# ---- GitHub Copilot CLI: remote MCP over streamable HTTP -------------------
wire_copilot() {
  step "GitHub Copilot CLI"
  if has "$URL/mcp" copilot mcp get spawnpoint; then
    ok "MCP server already registered"
  else
    if copilot mcp get spawnpoint >/dev/null 2>&1; then
      note "registered at a stale URL, re-pointing"
      copilot mcp remove spawnpoint >/dev/null 2>&1 || true
    fi
    if copilot mcp add spawnpoint "$URL/mcp" >/dev/null 2>&1; then
      ok "MCP server registered ($URL/mcp)"
    else
      warn "could not register; try: copilot mcp add spawnpoint $URL/mcp"
      return 1
    fi
  fi
  STEPS="$STEPS
  Copilot CLI:  run copilot and use a spawnpoint tool; approve the browser sign-in when prompted"
}

# ---- VS Code (Copilot Chat / agent mode) -----------------------------------
wire_vscode() {
  step "VS Code Copilot"
  if code --add-mcp "{\"name\":\"spawnpoint\",\"type\":\"http\",\"url\":\"$URL/mcp\"}" >/dev/null 2>&1; then
    ok "MCP server registered in the user profile ($URL/mcp)"
  else
    warn "could not register; in VS Code run \"MCP: Add Server\" and point it at $URL/mcp"
    return 1
  fi
  STEPS="$STEPS
  VS Code:      open Copilot Chat (agent mode) and start the spawnpoint server; sign in from the browser prompt"
}

# ---- jcode: stdio-only MCP, bridged through mcp-remote ---------------------
# Sign-in happens once, ahead of jcode, as for dsh: a headless `jcode run`
# gives a cold MCP server five seconds before it sends the prompt, and the
# bridge's browser sign-in takes longer, so a run that triggers it has no
# spawnpoint tools. The saved token serves every later session. The entry
# carries timeout_secs: jcode gives an MCP request 30 s unless the server's
# entry says otherwise (since 0.82; older versions ignore the key), and
# watch_deploy waits up to five minutes for a slow machine, so 330 covers its
# longest wait with headroom instead of handing the model a timeout error.
wire_jcode() {
  step "jcode"
  if ! command -v python3 >/dev/null 2>&1; then
    warn "python3 not found; add spawnpoint to ~/.jcode/mcp.json by hand"
    return 1
  fi
  if ! command -v npx >/dev/null 2>&1; then
    warn "npx not found; jcode speaks stdio-only MCP, so spawnpoint needs the mcp-remote bridge. Install Node.js, then re-run."
    return 1
  fi
  if ! SPAWNPOINT_MCP_URL="$URL/mcp" python3 - <<'PYEOF'
import json, os, pathlib
p = pathlib.Path.home() / ".jcode" / "mcp.json"
p.parent.mkdir(parents=True, exist_ok=True)
cfg = {}
if p.exists():
    try:
        cfg = json.loads(p.read_text() or "{}")
    except ValueError:
        raise SystemExit("existing mcp.json is not valid JSON; not touching it")
servers = cfg.setdefault("mcpServers", {})
servers["spawnpoint"] = {
    "command": "npx",
    "args": ["-y", "mcp-remote", os.environ["SPAWNPOINT_MCP_URL"]],
    "timeout_secs": 330,
}
p.write_text(json.dumps(cfg, indent=2) + "\n")
PYEOF
  then
    warn "could not update ~/.jcode/mcp.json"
    return 1
  fi
  ok "registered in ~/.jcode/mcp.json (mcp-remote bridge to $URL/mcp)"
  STEPS="$STEPS
  jcode:        sign in once with: npx -y mcp-remote $URL/mcp (approve in the browser, then Ctrl-C)"
}

# ---- DeepSeek Harness (dsh): MCP without OAuth, bridged through mcp-remote --
# dsh's MCP client (0.2.0-rc.2) sends only static headers over streamable HTTP,
# so it cannot run the OAuth flow /mcp asks for. mcp-remote runs it instead and
# keeps the tokens in ~/.mcp-auth. The entry goes in the home patch layer,
# $DSH_HOME/cordis.patch.yml, which every dsh profile applies. That file is
# YAML and may hold the user's own patches, so the installer owns only the
# block between its two marker lines: re-running replaces that block (which is
# how a stale URL gets re-pointed) and leaves everything else as it was.
# Sign-in happens once, ahead of dsh: dsh connects MCP servers at boot and
# gives each 60 s, so a browser sign-in raced against it can leave a session
# (and every headless run) without the spawnpoint tools.
wire_dsh() {
  step "DeepSeek Harness"
  if ! command -v python3 >/dev/null 2>&1; then
    warn "python3 not found; add spawnpoint to ~/.dsh/cordis.patch.yml by hand"
    return 1
  fi
  if ! command -v npx >/dev/null 2>&1; then
    warn "npx not found; DeepSeek Harness reaches spawnpoint through the mcp-remote bridge. Install Node.js, then re-run."
    return 1
  fi
  local rc=0
  SPAWNPOINT_MCP_URL="$URL/mcp" python3 - <<'PYEOF' || rc=$?
import os, pathlib, re, sys
home = pathlib.Path(os.environ.get("DSH_HOME") or pathlib.Path.home() / ".dsh")
p = home / "cordis.patch.yml"
block = """# >>> spawnpoint (written by https://getspawnpoint.com/install; re-run it to update)
- insert:
    - id: spawnpoint-mcp
      name: '@deepseek-ai/dsh-mcp-client'
      config:
        serverName: spawnpoint
        transport: stdio
        command: npx
        args: ['-y', 'mcp-remote', '%s']
# <<< spawnpoint
""" % os.environ["SPAWNPOINT_MCP_URL"]
text = p.read_text() if p.exists() else ""
ours = re.compile(r"^# >>> spawnpoint.*?^# <<< spawnpoint[^\n]*\n?", re.S | re.M)
content = [l.strip() for l in text.splitlines() if l.strip() and not l.strip().startswith("#")]
if ours.search(text):
    text = ours.sub(lambda m: block, text, count=1)
elif "serverName: spawnpoint" in text:
    sys.exit(3)  # a spawnpoint entry the installer did not write: leave it
elif not content:
    head = text.rstrip("\n") + "\n\n" if text.strip() else (
        "# Home patch layer for every dsh profile: a top-level YAML array of\n"
        "# loader patches, applied after each profile's own cordis.patch.yml.\n\n")
    text = head + block
elif content == ["[]"]:
    text = re.sub(r"^[ \t]*\[\][ \t]*$", lambda m: block.rstrip("\n"), text, count=1, flags=re.M)
elif content[0].startswith("-"):
    text = text.rstrip("\n") + "\n\n" + block
else:
    sys.exit("%s is not a top-level YAML list; not touching it" % p)
home.mkdir(parents=True, exist_ok=True)
p.write_text(text)
PYEOF
  if [ "$rc" -eq 3 ]; then
    note "a spawnpoint entry in ~/.dsh/cordis.patch.yml was not written by the installer; leaving it"
  elif [ "$rc" -ne 0 ]; then
    warn "could not update ~/.dsh/cordis.patch.yml"
    return 1
  else
    ok "registered in ~/.dsh/cordis.patch.yml (mcp-remote bridge to $URL/mcp)"
  fi
  STEPS="$STEPS
  DeepSeek Harness: sign in once with: npx -y mcp-remote $URL/mcp (approve in the browser, then Ctrl-C)"
}

# ---- Antigravity (Google): the agy CLI and the IDE share one MCP config ----
# Both read ~/.gemini/config/mcp_config.json (key serverUrl, not url). `agy mcp
# add` is add-or-update, so it writes the entry when the CLI is present (on
# PATH, or where its installer puts it); an IDE-only machine gets the same JSON
# written directly. Antigravity's MCP client runs the OAuth flow itself, from
# the CLI's /mcp manager or the IDE's MCP settings, and each keeps its own
# token. Antigravity reads ~/.gemini/GEMINI.md as global rules, so the
# installer adds a short spawnpoint rule there between marker lines it owns:
# with the tools out of sight the model has gone looking for a spawnpoint
# command line instead (seen with Gemini 3.8 Flash), and the rule points it at
# the tools. Re-running replaces only that block.
wire_antigravity() {
  step "Antigravity"
  local agy=""
  if command -v agy >/dev/null 2>&1; then
    agy="agy"
  elif [ -x "$HOME/.local/bin/agy" ]; then
    agy="$HOME/.local/bin/agy"
  fi
  if [ -n "$agy" ] && "$agy" mcp add spawnpoint "$URL/mcp" >/dev/null 2>&1; then
    ok "registered in ~/.gemini/config/mcp_config.json ($URL/mcp)"
  elif ! command -v python3 >/dev/null 2>&1; then
    warn "python3 not found; add spawnpoint to ~/.gemini/config/mcp_config.json by hand"
    return 1
  elif SPAWNPOINT_MCP_URL="$URL/mcp" python3 - <<'PYEOF'
import json, os, pathlib
p = pathlib.Path.home() / ".gemini" / "config" / "mcp_config.json"
p.parent.mkdir(parents=True, exist_ok=True)
cfg = {}
if p.exists():
    try:
        cfg = json.loads(p.read_text() or "{}")
    except ValueError:
        raise SystemExit("existing mcp_config.json is not valid JSON; not touching it")
servers = cfg.setdefault("mcpServers", {})
servers["spawnpoint"] = {"disabled": False, "serverUrl": os.environ["SPAWNPOINT_MCP_URL"]}
p.write_text(json.dumps(cfg, indent=2) + "\n")
PYEOF
  then
    ok "registered in ~/.gemini/config/mcp_config.json ($URL/mcp)"
  else
    warn "could not update ~/.gemini/config/mcp_config.json"
    return 1
  fi
  if command -v python3 >/dev/null 2>&1 && python3 - <<'PYEOF'
import pathlib, re
p = pathlib.Path.home() / ".gemini" / "GEMINI.md"
block = """<!-- >>> spawnpoint (written by https://getspawnpoint.com/install; re-run it to update) -->
## spawnpoint
To put an app online, or to get a public link for one, call the spawnpoint MCP tools:
deploy_project, then watch_deploy, and give the user the url it returns. There is no
spawnpoint command line, package, or API key to install, so do not look for one, and do
not deploy to another host instead.
<!-- <<< spawnpoint -->
"""
text = p.read_text() if p.exists() else ""
ours = re.compile(r"<!-- >>> spawnpoint.*?<!-- <<< spawnpoint -->\n?", re.S)
if ours.search(text):
    text = ours.sub(lambda m: block, text, count=1)
else:
    text = (text.rstrip("\n") + "\n\n" if text.strip() else "") + block
p.parent.mkdir(parents=True, exist_ok=True)
p.write_text(text)
PYEOF
  then
    ok "deploy rule added to ~/.gemini/GEMINI.md"
  else
    note "could not update ~/.gemini/GEMINI.md; the tools still work without the rule"
  fi
  STEPS="$STEPS
  Antigravity:  CLI: run agy, type /mcp, choose spawnpoint, Authenticate.
                IDE: quit and reopen it if it was open, then Customizations > Installed > MCP Servers > Authenticate."
}

# ---- the team: MCP servers and skills (SPAWNPOINT_TEAM) --------------------
# The code is traded before any agent is touched, so a dead code stops the
# run with nothing half done. Claude Code and Codex get the servers and the
# skills; the other agents get each server's address to add by hand, until
# each one's configuration is checked. A server is named after its app, or
# <team>-<app> when the agent already has another server by that name. Every
# skill folder the installer writes carries a .spawnpoint-team file, and a
# re-run replaces only those: a skill of the member's own by the same name
# is left alone. Nothing is removed, so a skill the team deleted stays until
# the member deletes it.
fetch_team() {
  command -v python3 >/dev/null 2>&1 || die "the team setup needs python3. Install it, then copy a new line from the team page."
  TEAM_FILE=$(mktemp)
  trap 'rm -f "$TEAM_FILE"' EXIT
  local status
  # The code goes on stdin, not in curl's arguments, where other users of
  # this machine could read it while the request runs.
  status=$(printf '%s' "$TEAM_CODE" | curl -sS --max-time 60 -G -o "$TEAM_FILE" -w '%{http_code}' \
    --data-urlencode "code@-" "$URL/api/install/team") || die "could not reach $URL for the team setup"
  if [ "$status" != 200 ]; then
    local msg
    msg=$(python3 -c 'import json,sys; print(json.load(open(sys.argv[1])).get("error",""))' "$TEAM_FILE" 2>/dev/null || true)
    die "${msg:-the team setup failed (HTTP $status)}"
  fi
}

team_servers() {  # name<TAB>fallback<TAB>url per server, each checked
  python3 - "$TEAM_FILE" <<'PYEOF'
import json, re, sys
name = re.compile(r"[a-z0-9][a-z0-9_-]{0,99}")
url = re.compile(r"https?://[A-Za-z0-9.:-]+/mcp")
for s in json.load(open(sys.argv[1])).get("servers", []):
    n, f, u = s.get("name", ""), s.get("fallback_name", ""), s.get("url", "")
    if name.fullmatch(n) and name.fullmatch(f) and url.fullmatch(u):
        print("%s\t%s\t%s" % (n, f, u))
PYEOF
}

team_skills_into() {  # writes every team skill under $1; prints what it did
  python3 - "$TEAM_FILE" "$1" <<'PYEOF'
import json, pathlib, re, shutil, sys
d = json.load(open(sys.argv[1]))
root = pathlib.Path(sys.argv[2])
valid = re.compile(r"[a-z0-9]+(-[a-z0-9]+)*")
for k in d.get("skills", []):
    name = k.get("name", "")
    if len(name) > 64 or not valid.fullmatch(name):
        continue
    files = []
    for f in k.get("files", []):
        p = f.get("path", "")
        parts = pathlib.PurePosixPath(p).parts
        if not p or p.startswith("/") or "\\" in p or ".." in parts or parts[0] == ".spawnpoint-team":
            files = None
            break
        files.append((p, f.get("content", "")))
    if not files:
        print("bad\t%s" % name)
        continue
    dest = root / name
    if dest.exists() and not (dest / ".spawnpoint-team").exists():
        print("kept\t%s" % name)
        continue
    tmp = root / (".%s.spawnpoint-tmp" % name)
    shutil.rmtree(tmp, ignore_errors=True)
    for p, content in files:
        out = tmp / p
        out.parent.mkdir(parents=True, exist_ok=True)
        out.write_text(content)
        if content.startswith("#!"):
            out.chmod(0o755)
    (tmp / ".spawnpoint-team").write_text("%s\nversion %s\n" % (d.get("team", ""), k.get("version", "")))
    if dest.exists():
        shutil.rmtree(dest)
    tmp.rename(dest)
    print("wrote\t%s\t%s" % (name, k.get("version", "")))
PYEOF
}

# <agent>_state NAME URL: 0 when the agent has NAME at URL, 1 when NAME is
# free, 2 when NAME is another server. <agent>_add NAME URL adds it.
claude_state() {
  local out
  out=$("$CLAUDE_BIN" mcp get "$1" 2>/dev/null) || return 1
  printf '%s' "$out" | grep -qF "$2" && return 0
  return 2
}
claude_add() { "$CLAUDE_BIN" mcp add --transport http --scope user "$1" "$2" >/dev/null 2>&1; }
codex_state() {
  local out
  out=$("$CODEX_BIN" mcp get "$1" 2>/dev/null) || return 1
  printf '%s' "$out" | grep -qF "$2" && return 0
  return 2
}
codex_add() { "$CODEX_BIN" mcp add "$1" --url "$2" >/dev/null 2>&1; }

TEAM_ADDED=""  # server names added to the agent team_servers_into last ran for

team_servers_into() {  # $1: claude or codex
  local name fallback url cand pick rc
  TEAM_ADDED=""
  while IFS=$'\t' read -r name fallback url; do
    [ -n "$name" ] || continue
    pick=""
    for cand in "$name" "$fallback"; do
      rc=0
      "$1_state" "$cand" "$url" || rc=$?
      if [ "$rc" -eq 0 ]; then
        ok "MCP server $cand already added"
        pick="-"
        break
      elif [ "$rc" -eq 1 ]; then
        pick="$cand"
        break
      fi
    done
    case "$pick" in
      -) ;;
      "") warn "$name and $fallback are both other servers here; add $url by hand" ;;
      *)
        if "$1_add" "$pick" "$url"; then
          if [ "$pick" = "$name" ]; then
            ok "MCP server $pick ($url)"
          else
            ok "MCP server $pick ($url): $name is another server here"
          fi
          TEAM_ADDED="$TEAM_ADDED $pick"
        else
          warn "could not add MCP server $pick ($url)"
        fi
        ;;
    esac
  done <<EOF
$(team_servers)
EOF
}

team_skills_report() {  # $1: where the skills went
  local kind name version shown="${1/#$HOME/~}"
  while IFS=$'\t' read -r kind name version; do
    case "$kind" in
      wrote) ok "skill $name (version $version)" ;;
      kept) note "skill $name: $shown/$name is a skill of yours, so it was left as it is" ;;
      bad) warn "skill $name has a file path outside its folder; skipped" ;;
    esac
  done <<EOF
$(team_skills_into "$1")
EOF
}

wired() { printf '%s' " $WIRED " | grep -q " $1 "; }

wire_team() {
  local team servers others=""
  team=$(python3 -c 'import json,sys; print(json.load(open(sys.argv[1])).get("team",""))' "$TEAM_FILE")
  servers=$(team_servers)
  step "Team: $team"
  if wired claude && CLAUDE_BIN=$(find_claude); then
    note "Claude Code"
    team_servers_into claude
    if [ -n "$TEAM_ADDED" ]; then
      STEPS="$STEPS
  Claude Code:  the team's servers sign in the same way, in /mcp: $(printf '%s' "${TEAM_ADDED# }" | sed 's/ /, /g')."
    fi
    team_skills_report "$HOME/.claude/skills"
  fi
  if wired codex && CODEX_BIN=$(find_codex); then
    note "Codex"
    team_servers_into codex
    local n
    for n in $TEAM_ADDED; do
      STEPS="$STEPS
  Codex:        run: codex mcp login $n"
    done
    team_skills_report "${CODEX_HOME:-$HOME/.codex}/skills"
  fi
  for a in $WIRED; do
    case "$a" in claude|codex) ;; *) others="$others $a" ;; esac
  done
  if [ -n "$others" ] && [ -n "$servers" ]; then
    note "Add the team's MCP servers to$others by hand for now:"
    printf '%s\n' "$servers" | while IFS=$'\t' read -r name _ url; do note "  $name  $url"; done
  fi
  if ! wired claude && ! wired codex; then
    note "the team's skills go into Claude Code and Codex, and neither is set up here"
  fi
}

# ---- detect + wire ---------------------------------------------------------
FOUND=""
# The CLI on PATH, or the desktop app's bundled runtime (find_claude covers both).
find_claude >/dev/null 2>&1 && FOUND="$FOUND claude"
{ command -v codex >/dev/null 2>&1 || [ -x "$CODEX_APP_BIN" ]; } && FOUND="$FOUND codex"
{ command -v cursor-agent >/dev/null 2>&1 || command -v cursor >/dev/null 2>&1 || [ -d "$HOME/.cursor" ]; } && FOUND="$FOUND cursor"
command -v opencode >/dev/null 2>&1 && FOUND="$FOUND opencode"
command -v copilot  >/dev/null 2>&1 && FOUND="$FOUND copilot"
command -v code     >/dev/null 2>&1 && FOUND="$FOUND vscode"
{ command -v jcode >/dev/null 2>&1 || [ -d "$HOME/.jcode" ]; } && FOUND="$FOUND jcode"
{ command -v dsh >/dev/null 2>&1 || [ -d "${DSH_HOME:-$HOME/.dsh}" ]; } && FOUND="$FOUND dsh"
# The agy CLI (PATH, or ~/.local/bin where its installer puts it), the IDE's
# config directory, or the IDE itself (macOS installs it per user or system-wide).
{ command -v agy >/dev/null 2>&1 || [ -x "$HOME/.local/bin/agy" ] || [ -d "$HOME/.gemini/config" ] || command -v antigravity >/dev/null 2>&1 || [ -d "/Applications/Antigravity.app" ] || [ -d "$HOME/Applications/Antigravity.app" ]; } && FOUND="$FOUND antigravity"

[ -n "$FOUND" ] || die "no supported agent found. Install Claude Code, Codex CLI, Cursor, opencode, GitHub Copilot, jcode, DeepSeek Harness, or Antigravity first."

[ -z "$TEAM_CODE" ] || fetch_team

for a in $FOUND; do
  if wants "$a"; then
    "wire_$a" && WIRED="$WIRED $a" || true
  fi
done
[ -n "$WIRED" ] || die "nothing was wired. Requested: ${AGENTS:-all}; found:${FOUND}."
[ -z "$TEAM_FILE" ] || wire_team

# ---- health ----------------------------------------------------------------
if curl -fsS --max-time 3 "$URL/healthz" >/dev/null 2>&1; then
  ok "spawnpoint is up at $URL"
else
  note "spawnpoint is not answering at $URL yet; start it before you authenticate"
fi

# ---- done ------------------------------------------------------------------
printf '\n  %sAll set%s (wired:%s). One sign-in step per agent, in the browser:\n' "$GREEN$BOLD" "$RESET" "$WIRED"
printf '%s\n' "$STEPS"
printf '\n  %sThen: "deploy" gets you a link. Docs: https://getspawnpoint.com%s\n\n' "$DIM" "$RESET"

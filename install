#!/bin/bash
#
# spawnpoint installer: wires spawnpoint into every coding agent on this
# machine (Claude Code, Codex CLI, Cursor, opencode, GitHub Copilot CLI,
# VS Code Copilot, jcode).
#
#   curl -fsSL https://getspawnpoint.com/install | bash
#
# Safe to re-run. Wires each agent it finds; skips the ones it doesn't.
# Restrict to specific agents with SPAWNPOINT_AGENT (comma-separated):
#
#   curl -fsSL https://getspawnpoint.com/install | SPAWNPOINT_AGENT=codex bash
#
# Points agents at the hosted spawnpoint (https://app.getspawnpoint.com) by
# default; override with SPAWNPOINT_URL for a dev instance:
#
#   curl -fsSL https://getspawnpoint.com/install | SPAWNPOINT_URL=http://localhost:8080 bash
set -euo pipefail

# ---- pretty ----------------------------------------------------------------
if [ -t 1 ] && [ -z "${NO_COLOR:-}" ]; then
  SP_MARK=$'\033[48;2;204;0;51m\033[1;97m'   # white on scarlet, the sp squircle
  RED=$'\033[38;2;204;0;51m'
  GREEN=$'\033[38;2;79;154;95m'
  DIM=$'\033[2m'
  BOLD=$'\033[1m'
  RESET=$'\033[0m'
else
  SP_MARK=""; RED=""; GREEN=""; DIM=""; BOLD=""; RESET=""
fi

step() { printf '%s==>%s %s%s%s\n' "$RED" "$RESET" "$BOLD" "$1" "$RESET"; }
ok()   { printf '  %s✓%s %s\n' "$GREEN" "$RESET" "$1"; }
note() { printf '  %s%s%s\n' "$DIM" "$1" "$RESET"; }
warn() { printf '  %s! %s%s\n' "$RED" "$1" "$RESET"; }
die()  { printf '  %sx %s%s\n' "$RED" "$1" "$RESET" >&2; exit 1; }

printf '\n  %s sp %s %sspawnpoint%s\n' "$SP_MARK" "$RESET" "$BOLD" "$RESET"
printf '       %sthe easiest way to bring your software online%s\n\n' "$DIM" "$RESET"

URL="${SPAWNPOINT_URL:-https://app.getspawnpoint.com}"
AGENTS="${SPAWNPOINT_AGENT:-}"
WIRED=""   # agents successfully wired
STEPS=""   # per-agent next-step lines, printed at the end

wants() {  # is this agent requested (or is everything requested)?
  [ -z "$AGENTS" ] || printf '%s' ",$AGENTS," | grep -q ",$1,"
}

# ---- Claude Code: plugin (skills) + MCP ------------------------------------
# The desktop app (Claude.app) bundles its own Claude Code runtime that reads
# the same user-scope config (~/.claude.json, ~/.claude/plugins) as the CLI.
# So a machine with only the desktop app still gets wired: find_claude prefers
# the PATH CLI, then falls back to the newest bundled runtime. Verified on
# macOS (app 1.28929.0 bundling Claude Code 2.1.227): mcp/plugin/marketplace
# subcommands all work headlessly through the bundled binary.
find_claude() {
  if command -v claude >/dev/null 2>&1; then
    printf 'claude'
    return 0
  fi
  local base="$HOME/Library/Application Support/Claude/claude-code"
  if [ -d "$base" ]; then
    local newest
    newest=$(ls "$base" 2>/dev/null | sort -V | tail -1)
    local bin="$base/$newest/claude.app/Contents/MacOS/claude"
    if [ -x "$bin" ]; then
      printf '%s' "$bin"
      return 0
    fi
  fi
  return 1
}

wire_claude() {
  step "Claude Code"
  local CLAUDE
  if ! CLAUDE=$(find_claude); then
    note "not found, skipping"
    return 1
  fi
  case "$CLAUDE" in
    claude) : ;;
    *) note "CLI not on PATH; using the desktop app's bundled runtime" ;;
  esac
  if "$CLAUDE" plugin marketplace add spawnpoint-inc/spawnpoint-plugin >/dev/null 2>&1; then
    ok "marketplace added (spawnpoint-inc/spawnpoint-plugin)"
  elif "$CLAUDE" plugin marketplace update spawnpoint >/dev/null 2>&1; then
    ok "marketplace already present, refreshed"
  else
    warn "could not add the marketplace; try: claude plugin marketplace add spawnpoint-inc/spawnpoint-plugin"
    return 1
  fi
  if "$CLAUDE" plugin list 2>/dev/null | grep -q 'spawnpoint@spawnpoint'; then
    ok "plugin already installed, updating"
    "$CLAUDE" plugin update spawnpoint@spawnpoint >/dev/null 2>&1 || true
  elif "$CLAUDE" plugin install spawnpoint@spawnpoint >/dev/null 2>&1; then
    ok "plugin installed (setup + deploy skills)"
  else
    warn "plugin install failed; try: claude plugin install spawnpoint@spawnpoint"
    return 1
  fi
  if "$CLAUDE" mcp list 2>/dev/null | grep -q '^spawnpoint:'; then
    ok "MCP server already registered"
  elif "$CLAUDE" mcp add --transport http --scope user spawnpoint "$URL/mcp" >/dev/null 2>&1; then
    ok "MCP server registered ($URL/mcp)"
  else
    warn "could not register; try: claude mcp add --transport http --scope user spawnpoint $URL/mcp"
    return 1
  fi
  case "$CLAUDE" in
    claude) STEPS="$STEPS
  Claude Code:  restart it, run /mcp, pick spawnpoint, choose Authenticate." ;;
    *) STEPS="$STEPS
  Claude app:   restart it, open the Code tab, run /mcp, pick spawnpoint, Authenticate." ;;
  esac
}

# ---- Codex CLI: MCP over streamable HTTP -----------------------------------
wire_codex() {
  step "Codex CLI"
  if codex mcp get spawnpoint >/dev/null 2>&1; then
    ok "MCP server already registered"
  elif codex mcp add spawnpoint --url "$URL/mcp" >/dev/null 2>&1; then
    ok "MCP server registered ($URL/mcp)"
  else
    warn "could not register; try: codex mcp add spawnpoint --url $URL/mcp"
    return 1
  fi
  STEPS="$STEPS
  Codex:        run: codex mcp login spawnpoint   (approve in the browser)"
}

# ---- Cursor (IDE + cursor-agent share ~/.cursor/mcp.json) ------------------
wire_cursor() {
  step "Cursor"
  if ! command -v python3 >/dev/null 2>&1; then
    warn "python3 not found; add spawnpoint to ~/.cursor/mcp.json by hand"
    return 1
  fi
  if ! SPAWNPOINT_MCP_URL="$URL/mcp" python3 - <<'PYEOF'
import json, os, pathlib
p = pathlib.Path.home() / ".cursor" / "mcp.json"
p.parent.mkdir(parents=True, exist_ok=True)
cfg = {}
if p.exists():
    try:
        cfg = json.loads(p.read_text() or "{}")
    except ValueError:
        raise SystemExit("existing mcp.json is not valid JSON; not touching it")
servers = cfg.setdefault("mcpServers", {})
servers["spawnpoint"] = {"url": os.environ["SPAWNPOINT_MCP_URL"]}
p.write_text(json.dumps(cfg, indent=2) + "\n")
PYEOF
  then
    warn "could not update ~/.cursor/mcp.json"
    return 1
  fi
  ok "registered in ~/.cursor/mcp.json ($URL/mcp)"
  if command -v cursor-agent >/dev/null 2>&1; then
    STEPS="$STEPS
  Cursor:       run: cursor-agent mcp login spawnpoint   (or approve in the IDE's MCP settings)"
  else
    STEPS="$STEPS
  Cursor:       open the IDE's MCP settings and approve spawnpoint (sign-in happens in the browser)."
  fi
}

# ---- opencode: remote MCP over streamable HTTP -----------------------------
wire_opencode() {
  step "opencode"
  if opencode mcp list 2>/dev/null | grep -q 'spawnpoint'; then
    ok "MCP server already registered"
  elif opencode mcp add spawnpoint --url "$URL/mcp" >/dev/null 2>&1; then
    ok "MCP server registered ($URL/mcp)"
  else
    warn "could not register; try: opencode mcp add spawnpoint --url $URL/mcp"
    return 1
  fi
  STEPS="$STEPS
  opencode:     run: opencode mcp auth spawnpoint   (approve in the browser)"
}

# ---- GitHub Copilot CLI: remote MCP over streamable HTTP -------------------
wire_copilot() {
  step "GitHub Copilot CLI"
  if copilot mcp get spawnpoint >/dev/null 2>&1; then
    ok "MCP server already registered"
  elif copilot mcp add spawnpoint "$URL/mcp" >/dev/null 2>&1; then
    ok "MCP server registered ($URL/mcp)"
  else
    warn "could not register; try: copilot mcp add spawnpoint $URL/mcp"
    return 1
  fi
  STEPS="$STEPS
  Copilot CLI:  run copilot and use a spawnpoint tool; approve the browser sign-in when prompted"
}

# ---- VS Code (Copilot Chat / agent mode) -----------------------------------
wire_vscode() {
  step "VS Code Copilot"
  if code --add-mcp "{\"name\":\"spawnpoint\",\"type\":\"http\",\"url\":\"$URL/mcp\"}" >/dev/null 2>&1; then
    ok "MCP server registered in the user profile ($URL/mcp)"
  else
    warn "could not register; in VS Code run \"MCP: Add Server\" and point it at $URL/mcp"
    return 1
  fi
  STEPS="$STEPS
  VS Code:      open Copilot Chat (agent mode) and start the spawnpoint server; sign in from the browser prompt"
}

# ---- jcode: stdio-only MCP, bridged through mcp-remote ---------------------
wire_jcode() {
  step "jcode"
  if ! command -v python3 >/dev/null 2>&1; then
    warn "python3 not found; add spawnpoint to ~/.jcode/mcp.json by hand"
    return 1
  fi
  if ! command -v npx >/dev/null 2>&1; then
    warn "npx not found; jcode speaks stdio-only MCP, so spawnpoint needs the mcp-remote bridge. Install Node.js, then re-run."
    return 1
  fi
  if ! SPAWNPOINT_MCP_URL="$URL/mcp" python3 - <<'PYEOF'
import json, os, pathlib
p = pathlib.Path.home() / ".jcode" / "mcp.json"
p.parent.mkdir(parents=True, exist_ok=True)
cfg = {}
if p.exists():
    try:
        cfg = json.loads(p.read_text() or "{}")
    except ValueError:
        raise SystemExit("existing mcp.json is not valid JSON; not touching it")
servers = cfg.setdefault("mcpServers", {})
servers["spawnpoint"] = {
    "command": "npx",
    "args": ["-y", "mcp-remote", os.environ["SPAWNPOINT_MCP_URL"]],
}
p.write_text(json.dumps(cfg, indent=2) + "\n")
PYEOF
  then
    warn "could not update ~/.jcode/mcp.json"
    return 1
  fi
  ok "registered in ~/.jcode/mcp.json (mcp-remote bridge to $URL/mcp)"
  STEPS="$STEPS
  jcode:        use a spawnpoint tool; mcp-remote opens the browser sign-in on first use"
}

# ---- detect + wire ---------------------------------------------------------
FOUND=""
# The CLI on PATH, or the desktop app's bundled runtime (find_claude covers both).
find_claude >/dev/null 2>&1 && FOUND="$FOUND claude"
command -v codex  >/dev/null 2>&1 && FOUND="$FOUND codex"
{ command -v cursor-agent >/dev/null 2>&1 || command -v cursor >/dev/null 2>&1 || [ -d "$HOME/.cursor" ]; } && FOUND="$FOUND cursor"
command -v opencode >/dev/null 2>&1 && FOUND="$FOUND opencode"
command -v copilot  >/dev/null 2>&1 && FOUND="$FOUND copilot"
command -v code     >/dev/null 2>&1 && FOUND="$FOUND vscode"
{ command -v jcode >/dev/null 2>&1 || [ -d "$HOME/.jcode" ]; } && FOUND="$FOUND jcode"

[ -n "$FOUND" ] || die "no supported agent found. Install Claude Code, Codex CLI, Cursor, opencode, GitHub Copilot, or jcode first."

for a in $FOUND; do
  if wants "$a"; then
    "wire_$a" && WIRED="$WIRED $a" || true
  fi
done
[ -n "$WIRED" ] || die "nothing was wired. Requested: ${AGENTS:-all}; found:${FOUND}."

# ---- health ----------------------------------------------------------------
if curl -fsS --max-time 3 "$URL/healthz" >/dev/null 2>&1; then
  ok "spawnpoint is up at $URL"
else
  note "spawnpoint is not answering at $URL yet; start it before you authenticate"
fi

# ---- done ------------------------------------------------------------------
printf '\n  %sAll set%s (wired:%s). One sign-in step per agent, in the browser:\n' "$GREEN$BOLD" "$RESET" "$WIRED"
printf '%s\n' "$STEPS"
printf '\n  %sThen: "deploy" gets you a link. Docs: https://getspawnpoint.com%s\n\n' "$DIM" "$RESET"
